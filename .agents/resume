#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

node_dir="$HOME/.local/node-v22.13.1-linux-x64"
dotnet_dir="$HOME/.local/dotnet"
local_bin="$HOME/.local/bin"
export DOTNET_ROOT="$dotnet_dir"
export PATH="$node_dir/bin:$dotnet_dir:$local_bin:$PATH"

if ! command -v node >/dev/null || ! command -v pnpm >/dev/null || ! command -v dotnet >/dev/null; then
  printf 'Orb toolchains are unavailable; run .agents/setup to repair them.\n' >&2
  exit 1
fi

printf 'Orb toolchains are ready: Node %s, pnpm %s, .NET %s\n' \
  "$(node --version)" "$(pnpm --version)" "$(dotnet --version)"
