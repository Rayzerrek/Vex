#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

node_version="22.13.1"
node_dir="$HOME/.local/node-v${node_version}-linux-x64"
dotnet_dir="$HOME/.local/dotnet"
local_bin="$HOME/.local/bin"

run_step() {
  local name="$1"
  shift
  local started
  started="$(date +%s)"
  printf '==> %s\n' "$name"
  "$@"
  printf '<== %s (%ss)\n' "$name" "$(( $(date +%s) - started ))"
}

mkdir -p "$local_bin"

if [[ ! -x "$node_dir/bin/node" ]] || [[ "$("$node_dir/bin/node" --version)" != "v${node_version}" ]]; then
  run_step "install Node.js ${node_version}" bash -c '
    archive="/tmp/node-v${1}-linux-x64.tar.xz"
    curl --fail --location --retry 3 --output "$archive" "https://nodejs.org/dist/v${1}/node-v${1}-linux-x64.tar.xz"
    rm -rf "$2"
    mkdir -p "$(dirname "$2")"
    tar -xJf "$archive" -C "$(dirname "$2")"
  ' _ "$node_version" "$node_dir"
fi

export PATH="$node_dir/bin:$local_bin:$PATH"

if [[ ! -x "$dotnet_dir/dotnet" ]] || [[ "$("$dotnet_dir/dotnet" --version)" != 10.* ]]; then
  run_step "install .NET 10 SDK" bash -c '
    installer="/tmp/dotnet-install.sh"
    curl --fail --location --retry 3 --output "$installer" https://dot.net/v1/dotnet-install.sh
    bash "$installer" --channel 10.0 --install-dir "$1" --no-path
  ' _ "$dotnet_dir"
fi

export DOTNET_ROOT="$dotnet_dir"
export PATH="$DOTNET_ROOT:$PATH"

if [[ ! -x "$local_bin/pnpm" ]] || [[ "$(pnpm --version)" != "11.5.2" ]]; then
  run_step "install pnpm 11.5.2" npm install --global --prefix "$HOME/.local" pnpm@11.5.2
fi

profile_marker="# vex orb toolchains"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
export DOTNET_ROOT="$dotnet_dir"
export PATH="$node_dir/bin:$dotnet_dir:$local_bin:\$PATH"
EOF
fi

run_step "install web dependencies" pnpm --dir web install --frozen-lockfile
run_step "restore .NET dependencies" dotnet restore windows/Vex.slnx -p:EnableWindowsTargeting=true

run_step "verify Node.js" node --version
run_step "verify pnpm" pnpm --version
run_step "verify .NET SDK" dotnet --version
