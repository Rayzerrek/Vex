<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendored copy of https://github.com/migueldeicaza/XtermSharp (MIT),
       retargeted from netstandard2.0 to net10.0 for the Windows port.
       Pty.cs (POSIX forkpty) is intentionally excluded; Kero.Terminal
       provides ConPTY instead. See VENDORED.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>XtermSharp</RootNamespace>
    <AssemblyName>XtermSharp</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NStack.Core" Version="1.1.1" />
  </ItemGroup>

</Project>
