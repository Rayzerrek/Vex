<UserControl x:Class="Kero.App.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Popup x:Name="OverlayPopup" AllowsTransparency="True" Placement="Center" 
           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
           Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <!-- Backdrop -->
            <Border Background="#80000000" MouseDown="Backdrop_MouseDown" />

            <!-- Overlay Panel -->
            <Border Background="{StaticResource KeroSurface}" 
                    BorderBrush="{StaticResource KeroBorder}" 
                    BorderThickness="1,0,0,0" 
                    Width="320" 
                    HorizontalAlignment="Right">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform" X="320"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource KeroBorder}" BorderThickness="0,0,0,1" Padding="16,12">
                        <DockPanel>
                            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseButton_Click" ToolTip="Close Settings">×</Button>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16,16,0">
                            <!-- Theme -->
                            <TextBlock Text="Theme" Foreground="{StaticResource KeroTextDim}" Margin="0,0,0,8"/>
                            <ListBox x:Name="ThemeListBox" 
                                     Background="Transparent" 
                                     BorderThickness="1" 
                                     BorderBrush="{StaticResource KeroBorder}"
                                     SelectionChanged="ThemeListBox_SelectionChanged"
                                     Margin="0,0,0,24">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource KeroText}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="chrome" Property="Background" Value="{StaticResource KeroAccent}"/>
                                                            <Setter TargetName="chrome" Property="TextElement.Foreground" Value="#17171A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="chrome" Property="Background" Value="{StaticResource KeroHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Font Family -->
                            <TextBlock Text="Font Family" Foreground="{StaticResource KeroTextDim}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding AvailableFonts}" 
                                      SelectedItem="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" 
                                      Background="{StaticResource KeroBackground}" 
                                      Foreground="{StaticResource KeroText}"
                                      BorderBrush="{StaticResource KeroBorder}"
                                      BorderThickness="1"
                                      Padding="8,6"
                                      Margin="0,0,0,24"/>

                            <!-- Font Size -->
                            <TextBlock Text="Font Size" Foreground="{StaticResource KeroTextDim}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,24">
                                <TextBlock Text="{Binding FontSize}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>
                                <Slider Minimum="10" Maximum="24" Value="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" 
                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Cursor Blink -->
                            <CheckBox Content="Cursor Blink" 
                                      IsChecked="{Binding CursorBlink}" 
                                      Foreground="{StaticResource KeroText}"
                                      Margin="0,0,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Popup>
</UserControl>
