<Window x:Class="Kero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Kero.App.Model"
        xmlns:local="clr-namespace:Kero.App"
        Title="kero" Width="1120" Height="700" MinWidth="640" MinHeight="400"
        Background="{StaticResource KeroBackground}"
        Foreground="{StaticResource KeroText}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Recursive pane tree: a leaf hosts a terminal, a split hosts two
             children with a draggable splitter. -->
        <DataTemplate DataType="{x:Type m:LeafPane}">
            <Border Background="{StaticResource KeroSurface}" BorderBrush="{StaticResource KeroBorder}"
                    BorderThickness="1" Margin="2">
                <ContentPresenter Content="{Binding View}"/>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource KeroAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SplitPane}">
            <local:SplitPaneView Pane="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: projects, like upstream's SidebarView. -->
        <Border Grid.Column="0" Background="{StaticResource KeroBackground}"
                BorderBrush="{StaticResource KeroBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10">
                    <DockPanel>
                        <TextBlock Text="kero" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" ToolTip="Settings" Click="Settings_Click">⚙</Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="New Project" Click="NewProject_Click">＋</Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel>
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="6,0"
                             MaxHeight="250">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource KeroHover}" TargetName="chrome"/>
                                                <Setter Property="BorderThickness" Value="2,0,0,0" TargetName="chrome"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource KeroAccent}" TargetName="chrome"/>
                                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource KeroSurface}" TargetName="chrome"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource KeroText}"/>
                                <TextBlock Text="{Binding WorkingDirectory}" FontSize="11"
                                           Foreground="{StaticResource KeroTextDim}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource KeroBorder}" Margin="12,4"/>
                
                <local:FileTreeView DataContext="{Binding SelectedProject}"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Main column: tab strip above the pane tree. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource KeroBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <ListBox DockPanel.Dock="Left"
                             ItemsSource="{Binding SelectedProject.Tabs}"
                             SelectedItem="{Binding SelectedProject.SelectedTab, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="BorderBrush" Value="{StaticResource KeroBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource KeroTextDim}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="chrome" Background="Transparent"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource KeroHover}" TargetName="chrome"/>
                                                    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource KeroText}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource KeroSurface}" TargetName="chrome"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="Transparent"
                                            MouseDown="TabHeader_MouseDown">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenu}">
                                            <MenuItem Header="Split Right" InputGestureText="Ctrl+Shift+→" Style="{StaticResource DarkMenuItem}" Click="TabSplitRight_Click"/>
                                            <MenuItem Header="Split Down" InputGestureText="Ctrl+Shift+↓" Style="{StaticResource DarkMenuItem}" Click="TabSplitDown_Click"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock x:Name="TitleBlock" Text="{Binding Title}" MaxWidth="180"
                                               TextTrimming="CharacterEllipsis" FontSize="15"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="TitleEditBox" Text="{Binding Title}" MaxWidth="180"
                                             Visibility="Collapsed" FontSize="15"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource KeroText}"
                                             Background="{StaticResource KeroSurface}"
                                             BorderBrush="{StaticResource KeroBorder}"
                                             KeyDown="TitleEditBox_KeyDown"
                                             LostFocus="TitleEditBox_LostFocus"/>
                                    <Button Style="{StaticResource GhostButton}" Padding="4,0"
                                            Margin="6,0,0,0" ToolTip="Close Tab"
                                            Click="CloseTab_Click">×</Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Style="{StaticResource GhostButton}" ToolTip="New Tab (Ctrl+Shift+T)"
                            Click="NewTab_Click">＋</Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Right (Ctrl+Shift+→)"
                                Click="SplitRight_Click">Split →</Button>
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Down (Ctrl+Shift+↓)"
                                Click="SplitDown_Click">Split ↓</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedProject.SelectedTab.Root}"/>
        </Grid>
        
        <Popup x:Name="PalettePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:CommandPalette x:Name="PaletteOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:SettingsOverlay x:Name="SettingsOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
    </Grid>
</Window>
