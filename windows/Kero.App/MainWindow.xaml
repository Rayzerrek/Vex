<Window x:Class="Kero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Kero.App.Model"
        xmlns:local="clr-namespace:Kero.App"
        Title="kero" Width="1120" Height="700" MinWidth="640" MinHeight="400"
        Background="{StaticResource KeroBackground}"
        Foreground="{StaticResource KeroText}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Recursive pane tree: a leaf hosts a terminal, a split hosts two
             children with a draggable splitter. -->
        <DataTemplate DataType="{x:Type m:LeafPane}">
            <Border Background="{StaticResource KeroSurface}" BorderBrush="{StaticResource KeroBorder}"
                    BorderThickness="1" Margin="2">
                <ContentPresenter Content="{Binding View}"/>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource KeroAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SplitPane}">
            <local:SplitPaneView Pane="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: projects, like upstream's SidebarView. -->
        <Border Grid.Column="0" Background="{StaticResource KeroBackground}"
                BorderBrush="{StaticResource KeroBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10">
                    <DockPanel>
                        <TextBlock Text="kero" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                ToolTip="New Project" Click="NewProject_Click">＋</Button>
                    </DockPanel>
                </Border>
                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="6,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource KeroHover}" TargetName="chrome"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource KeroSurface}" TargetName="chrome"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource KeroText}"/>
                                <TextBlock Text="{Binding WorkingDirectory}" FontSize="11"
                                           Foreground="{StaticResource KeroTextDim}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main column: tab strip above the pane tree. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource KeroBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Left"
                                  ItemsSource="{Binding SelectedProject.Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" BorderThickness="0,0,1,0"
                                        BorderBrush="{StaticResource KeroBorder}"
                                        MouseLeftButtonUp="TabHeader_Select">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Padding="4,0"
                                                Margin="6,0,0,0" ToolTip="Close Tab"
                                                Click="CloseTab_Click">×</Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" ToolTip="New Tab (Ctrl+Shift+T)"
                            Click="NewTab_Click">＋</Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Right (Ctrl+Shift+→)"
                                Click="SplitRight_Click">Split →</Button>
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Down (Ctrl+Shift+↓)"
                                Click="SplitDown_Click">Split ↓</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedProject.SelectedTab.Root}"/>
        </Grid>
    </Grid>
</Window>
