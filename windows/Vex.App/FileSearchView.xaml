<UserControl x:Class="Vex.App.FileSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Vex.App.Model"
             xmlns:local="clr-namespace:Vex.App"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type m:FileSearchResult}">
            <StackPanel>
                <TextBlock x:Name="NameBlock" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource VexText}"
                           TextTrimming="CharacterEllipsis"
                           local:TextHighlighter.Highlight="{Binding}"/>
                <TextBlock FontSize="10.5" Foreground="{StaticResource VexTextDim}"
                           TextTrimming="CharacterEllipsis" Text="{Binding DirectoryPart}"
                           ToolTip="{Binding RelativePath}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Search box -->
        <Border DockPanel.Dock="Top" Padding="10,6,10,4">
            <Grid>
                <TextBlock x:Name="SearchHint" Text="Search files…"
                           Foreground="{StaticResource VexTextDim}" FontSize="12"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center"
                         Background="{StaticResource VexSurface}"
                         Foreground="{StaticResource VexText}"
                         BorderBrush="{StaticResource VexBorder}"
                         BorderThickness="1" Padding="8,0"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            </Grid>
        </Border>

        <!-- Results -->
        <ListBox x:Name="ResultList"
                 Background="Transparent" BorderThickness="0" Padding="6,0,6,4"
                 MaxHeight="200"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ResultList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexHover}" TargetName="chrome"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexSurface}" TargetName="chrome"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>
