<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <ProjectReference Include="..\Vex.Terminal\Vex.Terminal.csproj" />
    <ProjectReference Include="..\Vex.Libghostty\Vex.Libghostty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**\*" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One Dark syntax-highlighting definitions for AvalonEdit. -->
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Vex</AssemblyTitle>
    <Product>Vex</Product>
    <Description>ConPTY terminal workspace with split panes, file tree, and editor.</Description>
    <Company>Vex</Company>
    <Authors>Vex</Authors>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Ahead-of-time compiled method bodies for the published exe: faster
         cold start than the default JIT tiering at process launch. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
