<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
    <ProjectReference Include="..\Vex.Terminal\Vex.Terminal.csproj" />
    <ProjectReference Include="..\Vex.Libghostty\Vex.Libghostty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-5.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- One Dark syntax-highlighting definitions for AvalonEdit. -->
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Vex</AssemblyTitle>
    <Product>Vex</Product>
    <Description>ConPTY terminal workspace with split panes, file tree, and editor.</Description>
    <Company>Vex</Company>
    <Authors>Vex</Authors>
    <!-- Single source of truth for the app version. The SDK derives
         FileVersion and AssemblyVersion from this, and AppInfo reads it back
         from the assembly for the UI, so nothing else needs updating. -->
    <Version>1.3.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Compress the bundle: the uncompressed exe is ~185 MB and every cold
         start pays full sequential I/O plus an AV scan of it. Decompression
         happens per-assembly at load; measured warm-start impact below. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <!-- ReadyToRun drastically increases the bundle size (from ~80MB to ~180MB)
         which hurts cold start time (AV scan + disk I/O). In .NET 10, Tiered
         compilation is fast enough that smaller file size beats precompiled AOT. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Native libraries (ghostty-vt.dll, hostfxr, ...) ship beside the exe
         instead of inside the bundle. Self-extracting them costs a
         first-launch extraction pass into %TEMP% before the first frame.
         NOTE: InvariantGlobalization is NOT usable here — WPF data bindings
         call XmlLanguage.GetSpecificCulture(), which throws
         InvalidOperationException when ICU cultures are unavailable. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
