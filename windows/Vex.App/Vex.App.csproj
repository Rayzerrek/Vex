<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
    <ProjectReference Include="..\Vex.Terminal\Vex.Terminal.csproj" />
    <ProjectReference Include="..\Vex.Libghostty\Vex.Libghostty.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-5.png" />
    <EmbeddedResource Include="Assets\wsl.png" LogicalName="Vex.App.Assets.wsl.png" />
    <Content Include="ShellIntegration\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Vex.App.StartupProgram</StartupObject>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Vex</AssemblyTitle>
    <Product>Vex</Product>
    <Description>ConPTY terminal workspace with tabs and split panes.</Description>
    <Company>Vex</Company>
    <Authors>Vex</Authors>
    <!-- Single source of truth for the app version. The SDK derives
         FileVersion and AssemblyVersion from this, and AppInfo reads it back
         from the assembly for the UI, so nothing else needs updating. -->
    <Version>1.6.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Keep startup assemblies directly accessible without decompression. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <!-- PublishOptimization.targets roots the measured startup assemblies;
         cold framework methods retain IL and compile on demand. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <!-- Native libraries (ghostty-vt.dll, hostfxr, ...) ship beside the exe
         instead of inside the bundle. Self-extracting them costs a
         first-launch extraction pass into %TEMP% before the first frame.
         NOTE: InvariantGlobalization is NOT usable here — WPF data bindings
         call XmlLanguage.GetSpecificCulture(), which throws
         InvalidOperationException when ICU cultures are unavailable. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>

  <Import Project="PublishOptimization.targets" />

  <Target Name="LimitReadyToRunToVex" BeforeTargets="_PrepareForReadyToRunCompilation"
          Condition="'$(PublishReadyToRun)' == 'true' and '$(PublishReadyToRunComposite)' != 'true'">
    <ItemGroup>
      <_ExcludeReadyToRunFile Include="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' and '%(ResolvedFileToPublish.Filename)' != 'Vex.App' and '%(ResolvedFileToPublish.Filename)' != 'Vex.Terminal' and '%(ResolvedFileToPublish.Filename)' != 'Vex.Libghostty'" />
      <PublishReadyToRunExclude Include="@(_ExcludeReadyToRunFile->'%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- Prune completely unused framework assemblies and debug engines from the self-contained
       single-file bundle. Microsoft.WindowsDesktop.App unconditionally pulls in Windows Forms,
       System.Data, Active Directory, VB, unused diagnostics, XPS/Printing, and CLR debugging engines.
       Keep System.Net: WPF converters reference WebRequest even for local cursors/images.
       NOTE: System.IO.Pipelines is required by .NET 10 JSON serialization.
       System.Configuration.ConfigurationManager and presentation assemblies (Ribbon,
       WindowsFormsIntegration, PresentationUI) MUST NOT be pruned: WPF loads them dynamically
       at startup via BaseCompatibilityPreferences and Baml2006SchemaContext.EnsureXmlnsAssembliesLoaded.
       System.Reflection.Metadata is also required by the .NET 10 WPF clipboard
       path when a mouse selection is copied. -->
  <Target Name="IdentifyUnusedPublishFiles" BeforeTargets="_PrepareForReadyToRunCompilation;_ComputeFilesToBundle">
    <ItemGroup>
      <_UnusedPublishFiles Include="@(ResolvedFileToPublish)"
        Condition="
          $([System.String]::Copy('%(Filename)').StartsWith('System.Windows.Forms')) or
          $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualBasic')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Data')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.DirectoryServices')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Private.DataContractSerialization')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Drawing')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Linq.Parallel')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Diagnostics.PerformanceCounter')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Diagnostics.EventLog')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Security.Cryptography.Pkcs')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Security.Cryptography.Csp')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Security.Cryptography.OpenSsl')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Runtime.Serialization')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Xml.Serialization')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Xml.XmlSerializer')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Xml.XPath')) or
          $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) or
          $([System.String]::Copy('%(Filename)').StartsWith('mscordbi')) or
          $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader')) or
          $([System.String]::Copy('%(Filename)').StartsWith('ReachFramework')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Printing')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Transactions')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.CodeDom')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Security.Cryptography.Xml')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Formats.Tar')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Formats.Nrbf')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Linq.AsyncEnumerable')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Threading.Tasks.Dataflow')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Text.Encoding.CodePages')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.IO.Compression.Brotli')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.IO.Compression.ZipFile')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.IO.Compression.FileSystem')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.IO.IsolatedStorage')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Runtime.InteropServices.JavaScript')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Web')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.ServiceModel')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.ServiceProcess')) or
          $([System.String]::Copy('%(Filename)').StartsWith('System.Threading.Channels')) or
          $([System.String]::Copy('%(Filename)').StartsWith('PresentationFramework.Luna')) or
          $([System.String]::Copy('%(Filename)').StartsWith('PresentationFramework.Royale')) or
          $([System.String]::Copy('%(Filename)').StartsWith('PresentationFramework.Aero.')) or
          $([System.String]::Copy('%(Filename)').StartsWith('PresentationFramework.Classic')) or
          '%(Filename)' == 'clrgcexp'
        " />
      <!-- Keep compiler references, but do not put discarded libraries into the
           composite image: pruning the bundle alone leaves their native code. -->
      <ResolvedFileToPublish Remove="@(_UnusedPublishFiles)" />
      <ResolvedFileToPublish Include="@(_UnusedPublishFiles)" ReferenceOnly="true" />
    </ItemGroup>
  </Target>

  <Target Name="PruneUnusedSingleFileAssemblies" BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="IdentifyUnusedPublishFiles">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_UnusedPublishFiles)" />
    </ItemGroup>
  </Target>

</Project>
