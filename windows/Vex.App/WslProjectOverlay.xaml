<local:OverlayControl x:Class="Vex.App.WslProjectOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Vex.App" Visibility="Collapsed">
    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="activeBar" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource VexAccentBlue}"
                                        VerticalAlignment="Center" Margin="-4,0,4,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource VexHover}"/>
                                <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Background" Value="{DynamicResource VexHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource VexText}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource VexPressFill}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource VexFocusBorder}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Overlay_PreviewKeyDown">
        <Border x:Name="Backdrop" Background="{DynamicResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>
        <local:RoundedSurface x:Name="Panel" Background="{DynamicResource VexSurface}" BorderBrush="{DynamicResource VexBorder}"
            BorderThickness="1" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
            RenderTransformOrigin="0.5,0.5" MouseDown="Panel_MouseDown">
            <Border.RenderTransform><TransformGroup>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="PanelTranslate" Y="8"/>
            </TransformGroup></Border.RenderTransform>
            <StackPanel Margin="22,20">
                <TextBlock Text="Open WSL project" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource VexText}"/>
                <TextBlock Text="Choose a folder. Your Linux environment is ready." Margin="0,5,0,18" FontSize="12" Foreground="{DynamicResource VexTextDim}"/>
                <Border x:Name="EnvironmentSummary" Background="{DynamicResource VexHover}" CornerRadius="6" Padding="12,10" Visibility="Collapsed">
                    <DockPanel>
                        <Image x:Name="EnvironmentIcon" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock x:Name="EnvironmentName" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource VexText}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <StackPanel x:Name="DistributionField" Visibility="Collapsed">
                    <TextBlock Text="Distribution" FontSize="11" Foreground="{DynamicResource VexTextDim}" Margin="0,0,0,6"/>
                    <ListBox x:Name="Distributions" MaxHeight="110" Background="{DynamicResource VexSurface}" BorderBrush="{DynamicResource VexBorder}"
                             BorderThickness="1" Padding="4" SelectionChanged="Distribution_SelectionChanged" AutomationProperties.Name="WSL distribution"/>
                </StackPanel>
                <StackPanel x:Name="ShellField" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="Shell" FontSize="11" Foreground="{DynamicResource VexTextDim}" Margin="0,0,0,6"/>
                    <ListBox x:Name="Shells" MaxHeight="110" DisplayMemberPath="Name" Background="{DynamicResource VexSurface}" BorderBrush="{DynamicResource VexBorder}"
                             BorderThickness="1" Padding="4" AutomationProperties.Name="Project Linux shell"/>
                </StackPanel>
                <TextBlock Text="Linux directory" FontSize="11" Foreground="{DynamicResource VexTextDim}" Margin="0,16,0,6"/>
                <DockPanel>
                    <Button Content="Browse…" Click="Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <TextBox x:Name="DirectoryPath" Text="~" MaxLength="4096" AutomationProperties.Name="Linux project directory"/>
                </DockPanel>
                <TextBlock Text="~ opens the selected distribution's home. Or enter /home/you/project." TextWrapping="Wrap"
                    Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource VexTextDim}"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource VexTextDim}"/>
                <DockPanel Margin="0,18,0,0" LastChildFill="False">
                    <Button x:Name="OpenButton" Content="Open project" Click="Open_Click" DockPanel.Dock="Right" FontWeight="SemiBold" BorderBrush="{DynamicResource VexFocusBorder}"/>
                    <Button Content="Cancel" Click="Cancel_Click" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                </DockPanel>
            </StackPanel>
        </local:RoundedSurface>
    </Grid>
</local:OverlayControl>
