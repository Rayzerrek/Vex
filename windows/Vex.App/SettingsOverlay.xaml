<local:OverlayControl x:Class="Vex.App.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vex.App"
             mc:Ignorable="d"
             Visibility="Collapsed">
    <UserControl.Resources>

        <!-- Settings-specific surfaces and accents. All colors ride on
             DynamicResource so the whole overlay re-tints with the active
             appearance (dark or light chrome) without rebuilding. The accent
             ramp (blue → violet) is reused from App.xaml. -->
        <SolidColorBrush x:Key="CardSurface" Color="{DynamicResource VexCardColor}"/>
        <SolidColorBrush x:Key="CardBorder" Color="{DynamicResource VexCardBorderColor}"/>
        <SolidColorBrush x:Key="TrackSurface" Color="{DynamicResource VexTrackColor}"/>
        <LinearGradientBrush x:Key="AccentSolid" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource VexAccentBlueColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource VexAccentPurpleColor}" Offset="1"/>
        </LinearGradientBrush>

        <local:SliderFillConverter x:Key="SliderFill"/>

        <!-- ComboBox/CheckBox chrome, used only by this overlay. Lives here
             instead of App.xaml so the startup App.xaml parse stays lean. -->
        <Style TargetType="ComboBox" x:Key="DarkComboBox">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource VexHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,6,24,6" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource VexSurface}" BorderThickness="1" BorderBrush="{DynamicResource VexBorder}" CornerRadius="4"/>
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem" x:Key="DarkComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource VexHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource VexAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource VexOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" x:Key="DarkCheckBox">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="box" Background="{DynamicResource VexSurface}"
                                        BorderBrush="{DynamicResource VexBorder}" BorderThickness="1" CornerRadius="3"/>
                                <Path x:Name="check" Data="M 3,8 L 6.5,11.5 L 13,4"
                                      Stroke="{DynamicResource VexText}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource VexAccent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource VexAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource VexTextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="fill" Background="Transparent" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"/>
                            <Border x:Name="hover" Background="{DynamicResource VexTabHover}" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="{DynamicResource VexTabSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="fill" Property="BorderBrush" Value="{DynamicResource VexAccent}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAppearanceOption" TargetType="RadioButton" BasedOn="{StaticResource SettingsNavItem}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- iOS-style toggle switch with a sliding thumb. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="{StaticResource TrackSurface}"/>
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="{DynamicResource VexToggleThumb}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="thumbShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentSolid}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbShift" Storyboard.TargetProperty="X" To="18" Duration="{x:Static local:UiMotion.RepositionDuration}" EasingFunction="{x:Static local:UiMotion.MovementEasing}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbShift" Storyboard.TargetProperty="X" To="0" Duration="{x:Static local:UiMotion.RepositionDuration}" EasingFunction="{x:Static local:UiMotion.MovementEasing}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single-line input for custom shell rows: field with an accent
             border on keyboard focus so edits read clearly. -->
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- An explicit Style replaces the app-level TextBox one, so the
                 caret has to be set here too; VexTextDim left it barely
                 visible against the input surface. -->
            <Setter Property="CaretBrush" Value="{DynamicResource VexText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="{DynamicResource VexAccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="{DynamicResource VexTrack}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled accent button used for primary in-card actions like
             confirming a new custom shell. Rides the same blue→violet
             gradient as the toggle track and theme badges. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource VexOnAccent}"/>
            <Setter Property="Background" Value="{DynamicResource VexAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                                <Setter Property="Foreground" Value="{DynamicResource VexTextDim}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider with a filled accent track and round thumb. -->
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border x:Name="TrackBack" Height="4" CornerRadius="2" Background="{StaticResource TrackSurface}" VerticalAlignment="Center"/>
                            <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="{StaticResource AccentSolid}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource SliderFill}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" ElementName="TrackBack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="knob" Fill="{DynamicResource VexToggleThumb}"/>
                                                    <Ellipse x:Name="halo" Fill="#338B939E" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card and label treatments. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource VexTextDim}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource VexTextDim}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource VexTextDim}"/>
            <Setter Property="Margin" Value="0,4,0,22"/>
        </Style>
    </UserControl.Resources>

    <Grid PreviewKeyDown="Overlay_PreviewKeyDown">
        <!-- Dimmed backdrop -->
        <Border x:Name="Backdrop" Background="{DynamicResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>

        <!-- Centered panel -->
        <Border x:Name="Panel"
                Background="{DynamicResource VexSurface}"
                BorderBrush="{DynamicResource VexBorder}"
                BorderThickness="1"
                CornerRadius="14"
                MaxWidth="880"
                MinWidth="560"
                Height="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="24,24"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PanelTranslate" Y="16"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource VexTabStrip}" CornerRadius="13,13,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource VexText}" VerticalAlignment="Center" Margin="16,0,14,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="general"
                                         Content="General" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="appearance"
                                         Content="Appearance" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="terminal"
                                         Content="Terminal" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="about"
                                         Content="About" Checked="Nav_Checked"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="30" Height="30" Margin="8,0,8,0"
                                Padding="0" Click="CloseButton_Click" ToolTip="Close Settings">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content pages, clipped so the slide-in transition stays clean. -->
<Border Grid.Row="1" BorderBrush="{DynamicResource VexBorder}" BorderThickness="0,1,0,0" ClipToBounds="True">
                    <Grid>
                        <!-- General -->
                        <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Startup shell and workspace layout." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="SHELL" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Shell" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="ShellDetail" Text="Interpreter used for new panes." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ShellCombo" Grid.Column="1"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                                  SelectionChanged="ShellCombo_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="CUSTOM SHELLS" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="CustomShellEmpty"
                                                   Text="No custom shells yet. Add any program — pwsh, bash, nu, even a remote tool — with its arguments."
                                                   Style="{StaticResource RowDesc}" Margin="0,0,0,2"/>

                                        <ItemsControl x:Name="CustomShellList" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardSurface}"
                                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                                       Foreground="{DynamicResource VexTextDim}" Margin="4,0,12,0"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Style="{StaticResource RowDesc}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Program}"/><Run Text=" "/><Run Text="{Binding Arguments}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                                                    Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                                                                    Click="CustomShellRemove_Click" ToolTip="Remove shell">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Inline creation form: an expanding sub-card shown on
                                             demand so adding a shell is a deliberate, validated step
                                             rather than a row of blank fields. -->
                                        <Border x:Name="CustomShellForm" Visibility="Collapsed"
                                                Background="{StaticResource CardSurface}"
                                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,4,0,10">
                                            <StackPanel>
                                                <TextBlock Text="New custom shell" Style="{StaticResource RowTitle}" Margin="0,0,0,12"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Name" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellNameBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Name shown in the shell picker"
                                                             TextChanged="CustomShellForm_Changed"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Program" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellProgramBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Path to the executable, or a command resolved via PATH"
                                                             TextChanged="CustomShellForm_Changed"/>
                                                    <Button Grid.Column="2" x:Name="CustomShellBrowseBtn"
                                                            Style="{StaticResource GhostButton}" Content="Browse&#x2026;"
                                                            Click="CustomShellBrowse_Click"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Arguments" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellArgsBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Optional command-line arguments"/>
                                                </Grid>
                                                <TextBlock x:Name="CustomShellFormHint" Style="{StaticResource RowDesc}"
                                                           Foreground="{DynamicResource VexTextDim}" Margin="0,0,0,10" Visibility="Collapsed"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" Content="Cancel"
                                                            Click="CustomShellCancel_Click" Margin="0,0,8,0"/>
                                                    <Button x:Name="CustomShellConfirmBtn" Style="{StaticResource AccentButton}"
                                                            Content="Add shell" Click="CustomShellConfirm_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource GhostButton}" Click="CustomShellAdd_Click"
                                                    ToolTip="Add a custom shell">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource VexText}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add shell" FontSize="12" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource VexText}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Launches any program with its arguments in a new pane."
                                                       Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="WINDOW EXIT" Style="{StaticResource SettingsSectionTitle}" Margin="2,14,0,8"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Confirm before exiting" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Ask before closing Vex when a process or unsaved file is active." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding ConfirmOnExit}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Appearance -->
                        <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Color themes for every terminal pane." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="APPEARANCE" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="App appearance" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Chooses which theme set is offered below." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="AppearanceDarkOption" Tag="dark" GroupName="VexAppearance"
                                                         Style="{StaticResource SettingsAppearanceOption}"
                                                         Checked="Appearance_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Dark" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="AppearanceLightOption" Tag="light" GroupName="VexAppearance"
                                                         Margin="10,0,0,0"
                                                         Style="{StaticResource SettingsAppearanceOption}"
                                                         Checked="Appearance_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Light" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="THEME" Style="{StaticResource SettingsSectionTitle}" Margin="2,14,0,8"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Color theme" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Applied to all open terminals." Style="{StaticResource RowDesc}" Margin="0,1,0,14"/>
                                        <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0"
                                                 SelectionChanged="ThemeList_SelectionChanged"
                                                 PreviewMouseLeftButtonDown="ThemeList_PreviewMouseLeftButtonDown"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,14,6"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="120" Cursor="Hand" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                                        <StackPanel.RenderTransform>
                                                            <ScaleTransform x:Name="cardScale" ScaleX="1" ScaleY="1"/>
                                                        </StackPanel.RenderTransform>
                                                        <Grid Width="120" Height="78">
                                                            <Border x:Name="ring" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                                <Border x:Name="swatch" CornerRadius="9" Background="{Binding Background}" BorderBrush="{DynamicResource VexCardBorder}" BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Red}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Green}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Yellow}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Blue}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Magenta}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Cyan}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Border>
                                                            <Grid x:Name="badge" Width="20" Height="20"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                                                <Ellipse Fill="{DynamicResource VexAccentBlue}"/>
                                                                <Path Data="M 3,7 L 6.5,10.5 L 13,3.5"
                                                                      Stroke="White" StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      Stretch="Uniform" Width="11" Height="9"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Grid>
                                                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                                                                   Foreground="{DynamicResource VexTextDim}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource VexAccentBlue}"/>
                                                            <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="name" Property="Foreground" Value="{DynamicResource VexText}"/>
                                                            <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{x:Static local:UiMotion.FeedbackDuration}" EasingFunction="{x:Static local:UiMotion.FeedbackEasing}"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Terminal -->
                        <ScrollViewer x:Name="PageTerminal" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="Terminal" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Fonts, cursor and selection behavior." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="FONT" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Font family" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Used for terminal text." Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                                      SelectedItem="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Font size" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Point size of terminal text." Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Value commits to the terminals on release, not per tick:
                                                     each commit resizes every ConPTY session. -->
                                                <Slider x:Name="FontSizeSlider" Style="{StaticResource SettingsSlider}"
                                                        Minimum="10" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                        VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{StaticResource TrackSurface}" CornerRadius="6"
                                                        MinWidth="34" Height="24" Margin="12,0,0,0" Padding="8,0">
                                                    <TextBlock Text="{Binding Value, ElementName=FontSizeSlider, StringFormat=0}" FontSize="12" Foreground="{DynamicResource VexText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="CURSOR" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Blinking cursor" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Pulse the caret while a pane is focused." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding CursorBlink}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="SELECTION" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy on select" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Automatically copy mouse selections to the clipboard."
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding CopyOnSelect}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- About -->
                        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="28,28" VerticalAlignment="Top">
                                <Image Source="/Assets/app-5.png" Width="40" Height="40" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Vex" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource VexText}"/>
                                    <TextBlock x:Name="AboutVersionText" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource VexTextDim}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</local:OverlayControl>
