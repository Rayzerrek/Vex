<local:OverlayControl x:Class="Vex.App.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vex.App"
             mc:Ignorable="d"
             Visibility="Collapsed">
    <UserControl.Resources>

        <!-- Settings-specific surfaces and accents. All colors ride on
             DynamicResource so the whole overlay re-tints with the active
             appearance (dark or light chrome) without rebuilding. The accent
             ramp (blue → violet) is reused from App.xaml. -->
        <SolidColorBrush x:Key="PanelSurface" Color="{DynamicResource VexSettingsPanelColor}"/>
        <SolidColorBrush x:Key="SidebarSurface" Color="{DynamicResource VexSettingsSidebarColor}"/>
        <SolidColorBrush x:Key="CardSurface" Color="{DynamicResource VexCardColor}"/>
        <SolidColorBrush x:Key="CardBorder" Color="{DynamicResource VexCardBorderColor}"/>
        <SolidColorBrush x:Key="TrackSurface" Color="{DynamicResource VexTrackColor}"/>
        <SolidColorBrush x:Key="NavHover" Color="{DynamicResource VexNavHoverColor}"/>
        <SolidColorBrush x:Key="NavSelected" Color="{DynamicResource VexNavSelectedColor}"/>
        <LinearGradientBrush x:Key="AccentSolid" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource VexAccentBlueColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource VexAccentPurpleColor}" Offset="1"/>
        </LinearGradientBrush>

        <local:SliderFillConverter x:Key="SliderFill"/>

        <!-- Sidebar navigation pill. -->
        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" CornerRadius="8">
                            <Grid>
                                <Border x:Name="pill" Background="{StaticResource NavSelected}" CornerRadius="8" Opacity="0"/>
                                <Border x:Name="hov" Background="{StaticResource NavHover}" CornerRadius="8" Opacity="0"/>
                                <ContentPresenter Margin="10,8"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="1"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style toggle switch with a sliding thumb. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="{StaticResource TrackSurface}"/>
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="{StaticResource VexToggleThumb}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="thumbShift" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentSolid}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single-line input for custom shell rows: field with an accent
             border on keyboard focus so edits read clearly. -->
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
            <Setter Property="Background" Value="{StaticResource VexInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- An explicit Style replaces the app-level TextBox one, so the
                 caret has to be set here too; VexTextDim left it barely
                 visible against the input surface. -->
            <Setter Property="CaretBrush" Value="{StaticResource VexText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="{StaticResource VexAccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="field" Property="BorderBrush" Value="{StaticResource VexTrack}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled accent button used for primary in-card actions like
             confirming a new custom shell. Rides the same blue→violet
             gradient as the toggle track and theme badges. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource VexToggleThumb}"/>
            <Setter Property="Background" Value="{StaticResource AccentSolid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                                <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider with a filled accent track and round thumb. -->
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border x:Name="TrackBack" Height="4" CornerRadius="2" Background="{StaticResource TrackSurface}" VerticalAlignment="Center"/>
                            <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="{StaticResource AccentSolid}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource SliderFill}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" ElementName="TrackBack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="knob" Fill="{StaticResource VexToggleThumb}"/>
                                                    <Ellipse x:Name="halo" Fill="#338B939E" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card and label treatments. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
            <Setter Property="Margin" Value="0,4,0,22"/>
        </Style>
    </UserControl.Resources>

    <Grid PreviewKeyDown="Overlay_PreviewKeyDown">
        <!-- Dimmed backdrop -->
        <Border x:Name="Backdrop" Background="{StaticResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>

        <!-- Centered panel -->
        <Border x:Name="Panel"
                Background="{StaticResource PanelSurface}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="14"
                MaxWidth="880"
                MinWidth="620"
                Height="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="48,40"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PanelTranslate" Y="16"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarSurface}" CornerRadius="13,0,0,13">
                    <DockPanel Margin="0,10,0,12">
                        <StackPanel DockPanel.Dock="Top" Margin="18,4,18,12">
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource VexText}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="18,0">
                            <TextBlock x:Name="SidebarVersionText" FontSize="11" Foreground="{StaticResource VexTextDim}"/>
                        </StackPanel>

                        <StackPanel>
                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="general" IsChecked="True" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="7" Background="#FF4C7BB5" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="General" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="appearance" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="7" Background="#FF8A6BB5" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Appearance" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="terminal" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="7" Background="#FF2E9E8F" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Terminal" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton Style="{StaticResource SettingsNavItem}" GroupName="SettingsNav" Tag="about" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="7" Background="#FFC98A3D" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="About" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content pages, clipped so the slide-in transition stays clean. -->
                <Border Grid.Column="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,0,0,0" ClipToBounds="True">
                    <Grid>
                        <!-- General -->
                        <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Startup shell and workspace layout." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="SHELL" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Shell" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="ShellDetail" Text="Interpreter used for new panes." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ShellCombo" Grid.Column="1"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                                  SelectionChanged="ShellCombo_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="CUSTOM SHELLS" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="CustomShellEmpty"
                                                   Text="No custom shells yet. Add any program — pwsh, bash, nu, even a remote tool — with its arguments."
                                                   Style="{StaticResource RowDesc}" Margin="0,0,0,2"/>

                                        <ItemsControl x:Name="CustomShellList" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource TrackSurface}"
                                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8"
                                                                    Background="{StaticResource VexHover}" Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                           Foreground="{StaticResource VexAccentBlue}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Style="{StaticResource RowDesc}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Program}"/><Run Text=" "/><Run Text="{Binding Arguments}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                                                    Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                                                                    Click="CustomShellRemove_Click" ToolTip="Remove shell">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Inline creation form: an expanding sub-card shown on
                                             demand so adding a shell is a deliberate, validated step
                                             rather than a row of blank fields. -->
                                        <Border x:Name="CustomShellForm" Visibility="Collapsed"
                                                Background="{StaticResource TrackSurface}"
                                                BorderBrush="{StaticResource VexAccentBlue}" BorderThickness="1"
                                                CornerRadius="8" Padding="14" Margin="0,4,0,10">
                                            <StackPanel>
                                                <TextBlock Text="New custom shell" Style="{StaticResource RowTitle}" Margin="0,0,0,12"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Name" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellNameBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Name shown in the shell picker"
                                                             TextChanged="CustomShellForm_Changed"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Program" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellProgramBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Path to the executable, or a command resolved via PATH"
                                                             TextChanged="CustomShellForm_Changed"/>
                                                    <Button Grid.Column="2" x:Name="CustomShellBrowseBtn"
                                                            Style="{StaticResource GhostButton}" Content="Browse&#x2026;"
                                                            Click="CustomShellBrowse_Click"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Arguments" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="CustomShellArgsBox"
                                                             Style="{StaticResource SettingsInput}"
                                                             ToolTip="Optional command-line arguments"/>
                                                </Grid>
                                                <TextBlock x:Name="CustomShellFormHint" Style="{StaticResource RowDesc}"
                                                           Foreground="{StaticResource VexAccentPurple}" Margin="0,0,0,10" Visibility="Collapsed"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" Content="Cancel"
                                                            Click="CustomShellCancel_Click" Margin="0,0,8,0"/>
                                                    <Button x:Name="CustomShellConfirmBtn" Style="{StaticResource AccentButton}"
                                                            Content="Add shell" Click="CustomShellConfirm_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button Style="{StaticResource GhostButton}" Click="CustomShellAdd_Click"
                                                    ToolTip="Add a custom shell">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{StaticResource VexAccentBlue}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add shell" FontSize="12" Margin="7,0,0,0"
                                                               Foreground="{StaticResource VexText}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Launches any program with its arguments in a new pane."
                                                       Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="INTERFACE" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Show sidebar" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Keep the project and file tree visible." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding SidebarVisible}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Appearance -->
                        <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Color themes for every terminal pane." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="APPEARANCE" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="App appearance" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Chooses which theme set is offered below." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="AppearanceDarkOption" Tag="dark" GroupName="VexAppearance"
                                                         Style="{StaticResource SettingsNavItem}"
                                                         Checked="Appearance_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Dark" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="AppearanceLightOption" Tag="light" GroupName="VexAppearance"
                                                         Margin="10,0,0,0"
                                                         Style="{StaticResource SettingsNavItem}"
                                                         Checked="Appearance_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Light" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="THEME" Style="{StaticResource SettingsSectionTitle}" Margin="2,14,0,8"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Color theme" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Applied to all open terminals." Style="{StaticResource RowDesc}" Margin="0,1,0,14"/>
                                        <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0"
                                                 SelectionChanged="ThemeList_SelectionChanged"
                                                 PreviewMouseLeftButtonDown="ThemeList_PreviewMouseLeftButtonDown"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,14,6"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="120" Cursor="Hand" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                                        <StackPanel.RenderTransform>
                                                            <ScaleTransform x:Name="cardScale" ScaleX="1" ScaleY="1"/>
                                                        </StackPanel.RenderTransform>
                                                        <Grid Width="120" Height="78">
                                                            <Border x:Name="ring" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                                <Border x:Name="swatch" CornerRadius="9" Background="{Binding Background}" BorderBrush="{StaticResource VexCardBorder}" BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Red}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Green}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Yellow}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Blue}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Magenta}" Margin="0,0,4,0"/>
                                                                        <Ellipse Width="9" Height="9" Fill="{Binding Cyan}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Border>
                                                            <Border x:Name="badge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSolid}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                                                <Path Data="M 5.5,10.5 L 8.5,13.5 L 14.5,6.5" Stroke="White" StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                                                                   Foreground="{StaticResource VexTextDim}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource VexAccentBlue}"/>
                                                            <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="name" Property="Foreground" Value="{StaticResource VexText}"/>
                                                            <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="cardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Terminal -->
                        <ScrollViewer x:Name="PageTerminal" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="Terminal" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Fonts and cursor behavior." Style="{StaticResource PageSubtitle}"/>

                                <TextBlock Text="FONT" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Font family" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Used for terminal text." Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                                      SelectedItem="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Font size" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Point size of terminal text." Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Value commits to the terminals on release, not per tick:
                                                     each commit resizes every ConPTY session. -->
                                                <Slider x:Name="FontSizeSlider" Style="{StaticResource SettingsSlider}"
                                                        Minimum="10" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                        VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{StaticResource TrackSurface}" CornerRadius="6"
                                                        MinWidth="34" Height="24" Margin="12,0,0,0" Padding="8,0">
                                                    <TextBlock Text="{Binding Value, ElementName=FontSizeSlider, StringFormat=0}" FontSize="12" Foreground="{StaticResource VexText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="CURSOR" Style="{StaticResource SettingsSectionTitle}"/>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Blinking cursor" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Pulse the caret while a pane is focused." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                  IsChecked="{Binding CursorBlink}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- About -->
                        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="28,26,28,20">
                                <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Vex is a ConPTY terminal workspace." Style="{StaticResource PageSubtitle}"/>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                        <Image Source="/Assets/app-5.png" Width="84" Height="84" HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="Vex" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource VexText}"
                                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                        <TextBlock x:Name="AboutVersionText" FontSize="12" Foreground="{StaticResource VexTextDim}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Split panes, a file tree and an editor over ConPTY sessions."
                                                   FontSize="12" Foreground="{StaticResource VexTextDim}" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="340"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Close button -->
                <Button Style="{StaticResource GhostButton}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,12,0" Width="30" Height="30" Padding="0" Click="CloseButton_Click" ToolTip="Close Settings">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource VexTextDim}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</local:OverlayControl>
