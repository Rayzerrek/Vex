<vex:OverlayControl x:Class="Vex.App.TabPeek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Vex.App.Model"
             xmlns:vex="clr-namespace:Vex.App"
             Visibility="Collapsed">
    <Grid>
        <Border x:Name="Backdrop" Background="{StaticResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>
        <Border x:Name="Panel" Background="{StaticResource VexSurface}"
                BorderBrush="{StaticResource VexBorder}"
                BorderThickness="1"
                CornerRadius="12"
                MaxWidth="900"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                MouseDown="Panel_MouseDown">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PanelTranslate" Y="8"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <DockPanel Margin="20,18,20,20" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="All tabs" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VexText}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="HintText" Text="← → move · Enter activate · Esc close" FontSize="11" Foreground="{StaticResource VexTextDim}" Margin="0,0,0,14"/>
                </StackPanel>

                <ListBox x:Name="TabList"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         MaxHeight="520"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="TabList_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                         SelectionChanged="TabList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,14"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:TabPeekPreview}">
                            <StackPanel Width="250" Cursor="Hand">
                                <Grid Width="250" Height="153">
                                    <Border x:Name="ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                        <Border CornerRadius="8" Background="{StaticResource VexBackground}" ClipToBounds="True">
                                            <Grid>
                                                <!-- Tabs that have not been displayed yet use their split layout;
                                                     visited tabs paint their last real rendered frame over it. -->
                                                <ContentControl Content="{Binding Layout}" Margin="7"/>
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                                <Grid Margin="3,7,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="name" Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                               Foreground="{StaticResource VexTextDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="count" Grid.Column="1" Text="{Binding PaneCount, StringFormat={}{0} panes}"
                                               FontSize="10" Foreground="{StaticResource VexTextDim}" Opacity="0.7"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource VexAccentBlue}"/>
                                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource VexText}"/>
                                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</vex:OverlayControl>
