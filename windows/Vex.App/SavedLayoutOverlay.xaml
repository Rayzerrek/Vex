<local:OverlayControl x:Class="Vex.App.SavedLayoutOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Vex.App" Visibility="Collapsed">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource VexText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource VexFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource VexText}"/>
            <Setter Property="Background" Value="{DynamicResource VexHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VexBorder}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource VexPressFill}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource VexFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Overlay_PreviewKeyDown">
        <Border x:Name="Backdrop" Background="{DynamicResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>
        <Border x:Name="Panel" Background="{DynamicResource VexSurface}" BorderBrush="{DynamicResource VexBorder}"
            BorderThickness="1" CornerRadius="10" Width="520" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
            RenderTransformOrigin="0.5,0.5" MouseDown="Panel_MouseDown">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PanelTranslate" Y="8"/>
                </TransformGroup>
            </Border.RenderTransform>
            <DockPanel Margin="22,18" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="Heading" Text="Save layout" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource VexText}"/>
                    <TextBlock Text="Open this pane layout in a new tab." FontSize="12" Foreground="{DynamicResource VexTextDim}" Margin="0,4,0,16"/>
                    <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource VexTextDim}" Margin="0,0,0,5"/>
                    <TextBox x:Name="LayoutName" MaxLength="64" Margin="0,0,0,15" AutomationProperties.Name="Layout name"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Pane" FontSize="11" Foreground="{DynamicResource VexTextDim}"/>
                        <TextBlock Grid.Column="1" Text="Directory" FontSize="11" Foreground="{DynamicResource VexTextDim}"/>
                        <TextBlock Grid.Column="2" Text="Command (optional)" FontSize="11" Foreground="{DynamicResource VexTextDim}"/>
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Directories are relative to the project. Empty commands open a shell." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource VexTextDim}"/>
                    <TextBlock x:Name="ErrorText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource VexPaneExited}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" DockPanel.Dock="Left" Visibility="Collapsed"/>
                        <Button Content="Save" Click="Save_Click" DockPanel.Dock="Right" FontWeight="SemiBold" BorderBrush="{DynamicResource VexFocusBorder}"/>
                        <Button Content="Cancel" Click="Cancel_Click" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                    <ItemsControl x:Name="PaneRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" Foreground="{DynamicResource VexTextDim}" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Pane.Directory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" MaxLength="1024" AutomationProperties.Name="Pane directory"/>
                                    <TextBox Grid.Column="2" Text="{Binding Pane.Command, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" AutomationProperties.Name="Pane command"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</local:OverlayControl>
