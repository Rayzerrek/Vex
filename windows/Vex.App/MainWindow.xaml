<Window x:Class="Vex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Vex.App.Model"
        xmlns:local="clr-namespace:Vex.App"
        Title="" Width="1120" Height="700" MinWidth="640" MinHeight="400"
        Background="{StaticResource VexBackground}"
        Foreground="{StaticResource VexText}"
        FontFamily="Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Recursive pane tree: a leaf hosts a terminal, a split hosts two
             children with a draggable splitter. -->
        <DataTemplate DataType="{x:Type m:TerminalPane}">
            <Border Background="Transparent" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="3" CornerRadius="9">
                <Grid local:RoundedClip.Radius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="PaneTitleBar_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource VexPaneTitleBar}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexPaneTitleBarFocused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Split Right (Ctrl+Shift+Right)" Click="PaneSplitRight_Click">
                                    <Path Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 7,1.5 V 12.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.1"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Split Down (Ctrl+Shift+Down)" Click="PaneSplitDown_Click">
                                    <Path Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 1.5,7 H 12.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.1"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Close Pane (Ctrl+Shift+W)" Click="PaneClose_Click">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                                <Image Width="13" Height="13" Margin="0,0,6,0" Source="{Binding AppIcon.Image}" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Path Data="M 2,2 L 6,5 L 2,8 M 6,8 L 10,8" Stroke="{StaticResource VexText}" StrokeThickness="1.1" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource VexText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding View}"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexFocusBorder}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:EditorPane}">
            <Border Background="{StaticResource VexSurface}" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="3" CornerRadius="9">
                <Grid local:RoundedClip.Radius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="PaneTitleBar_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource VexPaneTitleBar}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexPaneTitleBarFocused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Close Pane (Ctrl+Shift+W)" Click="PaneClose_Click">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                                <Path Data="M 2,1 H 9 L 12,4 V 13 H 2 Z M 9,1 V 4 H 12" Stroke="{StaticResource VexText}" StrokeThickness="1.1" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Fill="Transparent"/>
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource VexText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding View}"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexFocusBorder}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SplitPane}">
            <local:SplitPaneView Pane="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar across the top of the window -->
        <Border Grid.Row="0" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1">
        <Grid x:Name="TabBarGrid"
              Panel.ZIndex="100"
              Background="{StaticResource VexTabStrip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar toggle (Deck button) -->
            <Button Grid.Column="0" Style="{StaticResource DeckButton}"
                    Margin="8,0,4,0" Click="SidebarToggle_Click" ToolTip="Toggle Sidebar">
                <Path Data="M 1,4 A 1,1 0 0 1 2,3 H 9 A 1,1 0 0 1 10,4 V 11 A 1,1 0 0 1 9,12 H 2 A 1,1 0 0 1 1,11 Z M 3.5,1 H 11 A 1,1 0 0 1 12,2 V 9" 
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                      StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"/>
            </Button>

            <!-- Tabs: natural width, left-aligned from the toggle -->
            <ListBox Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="False"
                     ItemsSource="{Binding SelectedProject.Tabs}"
                     SelectedItem="{Binding SelectedProject.SelectedTab, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Margin" Value="2,4"/>
                        <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
                        <Setter Property="MaxWidth" Value="220"/>
                        <Setter Property="MinWidth" Value="100"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="fill" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VexTabSelected}" TargetName="fill"/>
                                            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VexTabHover}" TargetName="fill"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" MouseDown="TabHeader_MouseDown">
                            <Grid.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="Split Right" InputGestureText="Ctrl+Shift+→" Style="{StaticResource DarkMenuItem}" Click="TabSplitRight_Click"/>
                                    <MenuItem Header="Split Down" InputGestureText="Ctrl+Shift+↓" Style="{StaticResource DarkMenuItem}" Click="TabSplitDown_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Margin="0,0,6,0"
                                       Source="{Binding ActiveLeaf.AppIcon.Image}"
                                       VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveLeaf.AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- Terminal glyph shown when no app icon is available -->
                                <Path Data="M 2,2 L 6,5 L 2,8 M 6,8 L 10,8" Stroke="{StaticResource VexTextDim}" StrokeThickness="1.2" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveLeaf.AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock x:Name="TitleBlock" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" FontSize="13"
                                           ToolTip="{Binding Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="TitleEditBox" Grid.ColumnSpan="2" Text="{Binding Title}"
                                     Visibility="Collapsed" FontSize="14"
                                     VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                     Foreground="{StaticResource VexText}"
                                     Background="{StaticResource VexSurface}"
                                     BorderBrush="{StaticResource VexBorder}"
                                     KeyDown="TitleEditBox_KeyDown"
                                     LostFocus="TitleEditBox_LostFocus"/>
                            <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource CloseButton}"
                                    Margin="4,0,0,0" ToolTip="Close Tab"
                                    Click="CloseTab_Click"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="CloseScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Button.RenderTransform>
                                <TextBlock Text="×" FontSize="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Grid.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CloseBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Grid.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CloseBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleX" To="0.6" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleY" To="0.6" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- New Tab button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource GhostButton}" ToolTip="New Tab (Ctrl+Shift+T)" Width="30" Height="30" Padding="0" FontSize="16"
                        Click="NewTab_Click">＋</Button>
            </StackPanel>

            <!-- Drag region: empty stretch between tabs and caption buttons.
                 Hit-testing is off, so the WindowChrome caption (top 40px)
                 handles dragging here natively. -->
            <Border Grid.Column="3" WindowChrome.IsHitTestVisibleInChrome="False" Background="Transparent"/>

            <!-- Windows caption buttons: pinned to the top-right corner -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimize" Click="MinimizeWindow_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" Click="MaximizeWindow_Click">
                    <TextBlock x:Name="MaximizeButtonIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" ToolTip="Close" Click="CloseWindow_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Lower content panel containing Sidebar and active WorkspaceTab content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource VexSidebar}"
                    BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid x:Name="SidebarContent" Width="240" HorizontalAlignment="Left">
                    <DockPanel>
                        <!-- Sidebar header with settings and new project -->
                        <Border DockPanel.Dock="Top" Padding="10,8,10,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" ToolTip="Settings" Click="Settings_Click">⚙</Button>
                                    <Button Style="{StaticResource GhostButton}" ToolTip="New Project" Click="NewProject_Click">＋</Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Section label: projects -->
                        <Border DockPanel.Dock="Top" Padding="12,4,8,2">
                            <DockPanel>
                                <TextBlock Text="PROJECTS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource VexTextDim}"/>
                            </DockPanel>
                        </Border>

                        <!-- Projects ListBox -->
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Padding="6,0"
                                 MaxHeight="240"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexHover}" TargetName="chrome"/>
                                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexSurface}" TargetName="chrome"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Header="Remove Project" Style="{StaticResource DarkMenuItem}" Click="RemoveProject_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource VexText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding WorkingDirectory}" FontSize="11"
                                                       Foreground="{StaticResource VexTextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding WorkingDirectory}"/>
                                        </StackPanel>
                                        <Button x:Name="RemoveBtn" Grid.Column="1"
                                                Style="{StaticResource CloseButton}"
                                                Margin="4,0,2,0" ToolTip="Remove Project"
                                                Click="RemoveProject_Click"
                                                Visibility="Hidden" Opacity="0">
                                            <TextBlock Text="×" FontSize="15"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Grid.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Grid.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.1"/>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.1">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource VexBorder}" Margin="12,4"/>

                        <!-- Section label: files -->
                        <Border DockPanel.Dock="Top" Padding="12,6,8,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="FILES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource VexTextDim}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Refresh File Tree" Click="RefreshFileTree_Click" Padding="2" Width="22" Height="22" FontSize="11">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </DockPanel>
                        </Border>

                        <local:FileSearchView x:Name="FileSearch" DockPanel.Dock="Top"
                                              FileOpenRequested="FileSearch_FileOpenRequested"/>

                        <local:FileTreeView DataContext="{Binding SelectedProject}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Main content: the active tab's pane layout, with a
                 drag-to-split preview overlay on top. -->
            <Grid x:Name="ContentArea" Grid.Column="1">
                <ContentControl Content="{Binding SelectedProject.SelectedTab.Root}"/>
                <Canvas x:Name="DropOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="50">
                    <Border x:Name="SplitPreview" Background="#40FFFFFF" BorderBrush="#66FFFFFF"
                            BorderThickness="1" CornerRadius="8" Opacity="0" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Grid>
        
        <Popup x:Name="PalettePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:CommandPalette x:Name="PaletteOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:SettingsOverlay x:Name="SettingsOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
        <Popup x:Name="ThemePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:ThemeSwitcher x:Name="ThemeSwitcher" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
    </Grid>
</Window>
