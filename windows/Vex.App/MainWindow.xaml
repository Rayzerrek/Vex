<Window x:Class="Vex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Vex.App.Model"
        xmlns:local="clr-namespace:Vex.App"
        Title="Vex" Width="1120" Height="700" MinWidth="640" MinHeight="400"
        UseLayoutRounding="True"
        Background="{StaticResource VexBackground}"
        Foreground="{StaticResource VexText}"
        FontFamily="Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Recursive pane tree: a leaf hosts a terminal, a split hosts two
             children with a draggable splitter. -->
        <DataTemplate DataType="{x:Type m:TerminalPane}">
            <Border Background="Transparent" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="3" CornerRadius="9">
                <Grid local:RoundedClip.Radius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="PaneTitleBar_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource VexPaneTitleBar}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexPaneTitleBarFocused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <StackPanel x:Name="TerminalActionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0"
                                        Opacity="0">
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Focus this pane" Click="PaneFocus_Click">
                                    <Path Data="M9.79,12.79 C10.18,12.4 10.82,12.4 11.21,12.79 C11.57,13.15 11.6,13.72 11.29,14.11 L11.21,14.21 L6.41,19 L9,19 C9.55,19 10,19.45 10,20 C10,20.51 9.61,20.94 9.12,20.99 L9,21 L4,21 C3.49,21 3.06,20.61 3.01,20.12 L3,20 L3,15 C3,14.45 3.45,14 4,14 C4.51,14 4.94,14.39 4.99,14.88 L5,15 L5,17.59 L9.79,12.79 Z M20,3 C20.51,3 20.94,3.39 20.99,3.88 L21,4 L21,9 C21,9.55 20.55,10 20,10 C19.49,10 19.06,9.61 19.01,9.12 L19,9 L19,6.41 L14.21,11.21 C13.82,11.6 13.18,11.6 12.79,11.21 C12.43,10.85 12.4,10.28 12.71,9.89 L12.79,9.79 L17.59,5 L15,5 C14.45,5 14,4.55 14,4 C14,3.49 14.39,3.06 14.88,3.01 L15,3 L20,3 Z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Split Right (Ctrl+Shift+R)" Click="PaneSplitRight_Click">
                                    <Path Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 7,1.5 V 12.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.1"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Split Down (Ctrl+Shift+D)" Click="PaneSplitDown_Click">
                                    <Path Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 1.5,7 H 12.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.1"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Close Pane (Ctrl+Shift+W)" Click="PaneClose_Click">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource VexTextDim}"/>
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PaneState.Busy}">
                                                    <Setter Property="Fill" Value="{StaticResource VexAccentBlue}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static m:PaneState.Exited}">
                                                    <Setter Property="Fill" Value="{StaticResource VexPaneExited}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Image Width="13" Height="13" Margin="0,0,6,0" Source="{Binding AppIcon.Image}" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Path Data="M 2,2 L 6,5 L 2,8 M 6,8 L 10,8" Stroke="{StaticResource VexText}" StrokeThickness="1.1" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource VexText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding View}"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexFocusBorder}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TerminalActionButtons" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TerminalActionButtons" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:EditorPane}">
            <Border Background="{StaticResource VexSurface}" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="3" CornerRadius="9">
                <Grid local:RoundedClip.Radius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="PaneTitleBar_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource VexPaneTitleBar}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VexPaneTitleBarFocused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <StackPanel x:Name="EditorActionButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0"
                                        Opacity="0">
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Focus this pane" Click="PaneFocus_Click">
                                    <Path Data="M9.79,12.79 C10.18,12.4 10.82,12.4 11.21,12.79 C11.57,13.15 11.6,13.72 11.29,14.11 L11.21,14.21 L6.41,19 L9,19 C9.55,19 10,19.45 10,20 C10,20.51 9.61,20.94 9.12,20.99 L9,21 L4,21 C3.49,21 3.06,20.61 3.01,20.12 L3,20 L3,15 C3,14.45 3.45,14 4,14 C4.51,14 4.94,14.39 4.99,14.88 L5,15 L5,17.59 L9.79,12.79 Z M20,3 C20.51,3 20.94,3.39 20.99,3.88 L21,4 L21,9 C21,9.55 20.55,10 20,10 C19.49,10 19.06,9.61 19.01,9.12 L19,9 L19,6.41 L14.21,11.21 C13.82,11.6 13.18,11.6 12.79,11.21 C12.43,10.85 12.4,10.28 12.71,9.89 L12.79,9.79 L17.59,5 L15,5 C14.45,5 14,4.55 14,4 C14,3.49 14.39,3.06 14.88,3.01 L15,3 L20,3 Z"
                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource PaneTitleButton}" ToolTip="Close Pane (Ctrl+Shift+W)" Click="PaneClose_Click">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource VexTextDim}" Opacity="0.5"/>
                                <Path Data="M 2,1 H 9 L 12,4 V 13 H 2 Z M 9,1 V 4 H 12" Stroke="{StaticResource VexText}" StrokeThickness="1.1" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Fill="Transparent"/>
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource VexText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding View}"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexFocusBorder}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EditorActionButtons" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="EditorActionButtons" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SplitPane}">
            <local:SplitPaneView Pane="{Binding}"/>
        </DataTemplate>

        <!-- Reusable tab header (real tabs and the drag ghost). -->
        <DataTemplate x:Key="TabHeaderTemplate">
            <Grid Background="Transparent" MouseDown="TabHeader_MouseDown">
                <Grid.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Split Right" InputGestureText="Ctrl+Shift+R" Style="{StaticResource DarkMenuItem}" Click="TabSplitRight_Click"/>
                        <MenuItem Header="Split Down" InputGestureText="Ctrl+Shift+D" Style="{StaticResource DarkMenuItem}" Click="TabSplitDown_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Attention marker: lit for a background tab whose app
                         rang the bell, or whose process exited while the user
                         was elsewhere. It is the strip's answer to "which of
                         these wants me". -->
                    <Ellipse x:Name="AttentionDot" Width="6" Height="6" Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource VexAccentBlue}"
                             ToolTip="Waiting for you">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAttentionDot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveLeaf.State}" Value="{x:Static m:PaneState.Exited}">
                                        <Setter Property="Fill" Value="{StaticResource VexPaneExited}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Image Width="16" Height="16" Margin="0,0,6,0"
                           Source="{Binding ActiveLeaf.AppIcon.Image}"
                           VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveLeaf.AppIcon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Terminal glyph shown when no app icon is available -->
                    <Path Data="M 2,2 L 6,5 L 2,8 M 6,8 L 10,8" Stroke="{StaticResource VexTextDim}" StrokeThickness="1.2" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveLeaf.AppIcon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock x:Name="TitleBlock" Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" FontSize="13"
                               ToolTip="{Binding Title}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="TitleEditBox" Grid.ColumnSpan="2" Text="{Binding Title}"
                         Visibility="Collapsed" FontSize="14"
                         VerticalAlignment="Center" HorizontalAlignment="Stretch"
                         Foreground="{StaticResource VexText}"
                         Background="{StaticResource VexSurface}"
                         BorderBrush="{StaticResource VexBorder}"
                         KeyDown="TitleEditBox_KeyDown"
                         LostFocus="TitleEditBox_LostFocus"/>
                <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource CloseButton}"
                        Margin="4,0,0,0" ToolTip="Close Tab"
                        Click="CloseTab_Click"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="CloseScale" ScaleX="0.6" ScaleY="0.6"/>
                    </Button.RenderTransform>
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CloseBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Grid.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CloseBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleX" To="0.6" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="CloseScale" Storyboard.TargetProperty="ScaleY" To="0.6" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar across the top of the window -->
        <Border Grid.Row="0" BorderThickness="0">
        <Grid x:Name="TabBarGrid"
              Panel.ZIndex="100"
              Background="{StaticResource VexTabStrip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Tabs own the flexible column: with a few dozen tabs the
                     strip must shrink and scroll, never push the caption
                     buttons out of the window. -->
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar toggle: the panel-layout glyph (a frame with a
                 divider near the left edge) so the button reads as "the
                 sidebar" rather than the old stacked-rectangles mark. -->
            <Button Grid.Column="0" Style="{StaticResource DeckButton}"
                    Margin="8,0,4,0" Click="SidebarToggle_Click" ToolTip="Toggle Sidebar">
                <Path Data="M 3.5,2.5 H 12.5 A 2,2 0 0 1 14.5,4.5 V 11.5 A 2,2 0 0 1 12.5,13.5 H 3.5 A 2,2 0 0 1 1.5,11.5 V 4.5 A 2,2 0 0 1 3.5,2.5 Z M 6,2.5 V 13.5"
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform" Fill="Transparent"/>
            </Button>

            <!-- Tabs: natural width, left-aligned from the toggle -->
            <ListBox x:Name="TabStrip" Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="False"
                     ItemsSource="{Binding SelectedProject.Tabs}"
                     SelectedItem="{Binding SelectedProject.SelectedTab, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     PreviewMouseWheel="TabStrip_PreviewMouseWheel"
                     SelectionChanged="TabStrip_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Margin" Value="2,4"/>
                        <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
                        <Setter Property="MaxWidth" Value="220"/>
                        <!-- Narrow enough that a busy strip keeps every tab
                             (and the new-tab button) on screen. -->
                        <Setter Property="MinWidth" Value="84"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="fill" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VexTabSelected}" TargetName="fill"/>
                                            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource VexText}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VexTabHover}" TargetName="fill"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TabHeaderTemplate}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Insertion marker + drag ghost shown while reordering tabs. -->
            <Canvas x:Name="TabDragCanvas" Grid.Column="1" IsHitTestVisible="False">
                <Border x:Name="TabDropMarker" Width="2" Height="22"
                        CornerRadius="1" Background="{StaticResource VexAccent}" Opacity="0"/>
                <Border x:Name="TabDragGhostHost" CornerRadius="8"
                        Background="{StaticResource VexTabSelected}"
                        Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <ContentControl x:Name="TabDragGhost" IsHitTestVisible="False"
                                    ContentTemplate="{StaticResource TabHeaderTemplate}"/>
                </Border>
            </Canvas>

            <!-- New Tab button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource GhostButton}" ToolTip="New Tab (Ctrl+Shift+T)" Width="30" Height="30" Padding="0"
                        Click="NewTab_Click">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Drag region: empty stretch between tabs and caption buttons.
                 Hit-testing is off, so the WindowChrome caption (top 40px)
                 handles dragging here natively. -->
            <Border Grid.Column="3" WindowChrome.IsHitTestVisibleInChrome="False" Background="Transparent"/>

            <!-- Windows caption buttons: pinned to the top-right corner -->
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimize" Click="MinimizeWindow_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" Click="MaximizeWindow_Click">
                    <TextBlock x:Name="MaximizeButtonIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" ToolTip="Close" Click="CloseWindow_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Lower content panel containing Sidebar and active WorkspaceTab content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource VexSidebar}"
                    ClipToBounds="True">
                <Grid x:Name="SidebarContent" Width="240" HorizontalAlignment="Left">
                    <DockPanel>
                        <!-- Sidebar header with settings and new project -->
                        <Border DockPanel.Dock="Top" Padding="10,8,10,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" ToolTip="Settings" Click="Settings_Click">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" ToolTip="New Project" Click="NewProject_Click">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Section label: projects -->
                        <Border DockPanel.Dock="Top" Padding="12,4,8,2">
                            <DockPanel>
                                <TextBlock Text="PROJECTS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource VexTextDim}"/>
                            </DockPanel>
                        </Border>

                        <!-- Projects ListBox -->
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Padding="6,0"
                                 MaxHeight="240"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexHover}" TargetName="chrome"/>
                                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexSurface}" TargetName="chrome"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Header="Remove Project" Style="{StaticResource DarkMenuItem}" Click="RemoveProject_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource VexText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding WorkingDirectory}" FontSize="11"
                                                       Foreground="{StaticResource VexTextDim}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding WorkingDirectory}"/>
                                        </StackPanel>
                                        <Button x:Name="RemoveBtn" Grid.Column="1"
                                                Style="{StaticResource CloseButton}"
                                                Margin="4,0,2,0" ToolTip="Remove Project"
                                                Click="RemoveProject_Click"
                                                Visibility="Hidden" Opacity="0">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Grid.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Grid.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.1"/>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.1">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource VexBorder}" Margin="12,4"/>

                        <!-- Section label: files -->
                        <Border DockPanel.Dock="Top" Padding="12,6,8,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="FILES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource VexTextDim}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Refresh File Tree" Click="RefreshFileTree_Click" Padding="2" Width="22" Height="22" FontSize="11">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </DockPanel>
                        </Border>

                        <local:FileSearchView x:Name="FileSearch" DockPanel.Dock="Top"
                                              FileOpenRequested="FileSearch_FileOpenRequested"/>

                        <local:FileTreeView DataContext="{Binding SelectedProject}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Main content: the active tab's pane layout, with a
                 drag-to-split preview overlay on top. -->
            <Grid x:Name="ContentArea" Grid.Column="1" Background="{StaticResource VexTabStrip}">
                <ContentControl Content="{Binding SelectedProject.SelectedTab.DisplayRoot}"/>
                <Canvas x:Name="DropOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="50">
                    <Border x:Name="SplitPreview" Background="{StaticResource VexSplitPreview}" BorderBrush="{StaticResource VexSplitPreviewBorder}"
                            BorderThickness="1" CornerRadius="8" Opacity="0" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Grid>
        
        <Popup x:Name="PalettePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True"/>
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True"/>
        <Popup x:Name="ThemePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True"/>
        <Popup x:Name="TabPeekPopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True"/>
    </Grid>
</Window>
