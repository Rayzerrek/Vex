<Window x:Class="Vex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Vex.App.Model"
        xmlns:local="clr-namespace:Vex.App"
        Title="" Width="1120" Height="700" MinWidth="640" MinHeight="400"
        Background="{StaticResource VexBackground}"
        Foreground="{StaticResource VexText}"
        FontFamily="Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Recursive pane tree: a leaf hosts a terminal, a split hosts two
             children with a draggable splitter. -->
        <DataTemplate DataType="{x:Type m:TerminalPane}">
            <Border Background="{StaticResource VexSurface}" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="2">
                <ContentPresenter Content="{Binding View}"/>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:EditorPane}">
            <Border Background="{StaticResource VexSurface}" BorderBrush="{StaticResource VexBorder}"
                    BorderThickness="1" Margin="2">
                <ContentPresenter Content="{Binding View}"/>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VexAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type m:SplitPane}">
            <local:SplitPaneView Pane="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: projects, like upstream's SidebarView. -->
        <Border Grid.Column="0" Background="{StaticResource VexBackground}"
                BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="40" Padding="12,0" Background="{StaticResource VexBackground}">
                    <DockPanel>
                        <TextBlock Text="" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" Foreground="{StaticResource VexText}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" ToolTip="Settings" Click="Settings_Click">⚙</Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="New Project" Click="NewProject_Click">＋</Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel>
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="6,0"
                             MaxHeight="250">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="chrome" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource VexHover}" TargetName="chrome"/>
                                                <Setter Property="BorderThickness" Value="2,0,0,0" TargetName="chrome"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource VexAccent}" TargetName="chrome"/>
                                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource VexSurface}" TargetName="chrome"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                        <MenuItem Header="Remove Project" Style="{StaticResource DarkMenuItem}" Click="RemoveProject_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource VexText}"/>
                                    <TextBlock Text="{Binding WorkingDirectory}" FontSize="11"
                                               Foreground="{StaticResource VexTextDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="RemoveBtn" Grid.Column="1"
                                        Style="{StaticResource GhostButton}" Padding="4,0"
                                        Margin="4,0,0,0" ToolTip="Remove Project"
                                        Click="RemoveProject_Click"
                                        Visibility="Hidden" Opacity="0"
                                        Foreground="{StaticResource VexTextDim}">
                                    <TextBlock Text="×" FontSize="14"/>
                                </Button>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Grid.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Grid.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.1"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RemoveBtn" Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.1">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource VexBorder}" Margin="12,4"/>
                
                <local:FileTreeView DataContext="{Binding SelectedProject}"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Main column: tab strip above the pane tree. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="40" Background="{StaticResource VexBackground}" BorderBrush="{StaticResource VexBorder}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Window Caption / Control Buttons (Min, Max, Close) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimize" Click="MinimizeWindow_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" Click="MaximizeWindow_Click">
                            <TextBlock x:Name="MaximizeButtonIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" ToolTip="Close" Click="CloseWindow_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>

                    <!-- Split buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Right (Ctrl+Shift+→)"
                                Click="SplitRight_Click">Split →</Button>
                        <Button Style="{StaticResource GhostButton}" ToolTip="Split Down (Ctrl+Shift+↓)"
                                Click="SplitDown_Click">Split ↓</Button>
                    </StackPanel>

                    <!-- Tabs container docked to Left -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <ListBox WindowChrome.IsHitTestVisibleInChrome="True"
                                 ItemsSource="{Binding SelectedProject.Tabs}"
                                 SelectedItem="{Binding SelectedProject.SelectedTab, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource VexBorder}"/>
                                    <Setter Property="Foreground" Value="{StaticResource VexTextDim}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="chrome" Background="Transparent"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexHover}" TargetName="chrome"/>
                                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource VexText}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource VexSurface}" TargetName="chrome"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                                MouseDown="TabHeader_MouseDown">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Header="Split Right" InputGestureText="Ctrl+Shift+→" Style="{StaticResource DarkMenuItem}" Click="TabSplitRight_Click"/>
                                                <MenuItem Header="Split Down" InputGestureText="Ctrl+Shift+↓" Style="{StaticResource DarkMenuItem}" Click="TabSplitDown_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock x:Name="TitleBlock" Text="{Binding Title}" MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="TitleEditBox" Text="{Binding Title}" MaxWidth="180"
                                                 Visibility="Collapsed" FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource VexText}"
                                                 Background="{StaticResource VexSurface}"
                                                 BorderBrush="{StaticResource VexBorder}"
                                                 KeyDown="TitleEditBox_KeyDown"
                                                 LostFocus="TitleEditBox_LostFocus"/>
                                        <Button Style="{StaticResource GhostButton}" Padding="4,0"
                                                Margin="6,0,0,0" ToolTip="Close Tab"
                                                Click="CloseTab_Click">×
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- New Tab button -->
                        <Button Style="{StaticResource GhostButton}" ToolTip="New Tab (Ctrl+Shift+T)"
                                VerticalAlignment="Center" Margin="6,0,0,0" Width="26" Height="26"
                                Padding="0" FontSize="12" Click="NewTab_Click">＋</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedProject.SelectedTab.Root}"/>
        </Grid>
        
        <Popup x:Name="PalettePopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:CommandPalette x:Name="PaletteOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" StaysOpen="True">
            <local:SettingsOverlay x:Name="SettingsOverlay" Width="{Binding ActualWidth, ElementName=MainGrid}" Height="{Binding ActualHeight, ElementName=MainGrid}"/>
        </Popup>
    </Grid>
</Window>
