<vex:OverlayControl x:Class="Vex.App.ThemeSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Vex.App.Model"
             xmlns:vex="clr-namespace:Vex.App"
             Visibility="Collapsed">
    <Grid>
        <Border x:Name="Backdrop" Background="{StaticResource VexBackdropScrim}" MouseDown="Backdrop_MouseDown" Opacity="0"/>
        <Border x:Name="Panel" Background="{StaticResource VexSurface}"
                BorderBrush="{StaticResource VexBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Width="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                MouseDown="Panel_MouseDown">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96"/>
                    <TranslateTransform x:Name="PanelTranslate" Y="8"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel Margin="20,18,20,20">
                <DockPanel Margin="0,0,0,14">
                    <Button x:Name="EditToggle" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Padding="10,4" FontSize="11" Click="EditToggle_Click"
                            Content="Edit"/>
                    <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource VexText}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="HintText" Text="← → move · Enter keep · Esc revert" FontSize="11" Foreground="{StaticResource VexTextDim}" Margin="0,0,0,14"/>

                <!-- Theme card grid -->
                <ListBox x:Name="ThemeList"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewKeyDown="ThemeList_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="ThemeList_PreviewMouseLeftButtonDown"
                         SelectionChanged="ThemeList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:TerminalTheme}">
                            <StackPanel Width="120" Cursor="Hand" Background="Transparent">
                                <Grid Width="120" Height="78">
                                    <Border x:Name="ring" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                        <Border x:Name="swatch" CornerRadius="9" Background="{Binding Background}" BorderBrush="{StaticResource VexCardBorder}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Blue}" Margin="0,0,4,0"/>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Green}" Margin="0,0,4,0"/>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Yellow}" Margin="0,0,4,0"/>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Red}" Margin="0,0,4,0"/>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Magenta}" Margin="0,0,4,0"/>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Cyan}"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <Border x:Name="badge" Width="20" Height="20" CornerRadius="10" Background="{StaticResource VexAccentBlue}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed">
                                        <Path Data="M 5.5,10.5 L 8.5,13.5 L 14.5,6.5" Stroke="White" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" Margin="2,6,0,0"
                                           Foreground="{StaticResource VexTextDim}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource VexAccentBlue}"/>
                                    <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource VexText}"/>
                                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Theme editor panel (collapsed by default) -->
                <Border x:Name="EditorPanel" Visibility="Collapsed" Margin="0,4,0,0"
                        BorderBrush="{StaticResource VexBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <WrapPanel x:Name="ColorGrid" Orientation="Horizontal"/>

                        <DockPanel Margin="0,14,0,0">
                            <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Padding="10,4" FontSize="11" Click="ExportButton_Click" Content="Copy JSON"/>
                            <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="ResetButton_Click" Content="Reset"/>
                            <TextBlock Text="Custom" FontSize="12" Foreground="{StaticResource VexTextDim}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</vex:OverlayControl>
